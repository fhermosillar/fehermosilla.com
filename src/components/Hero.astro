---
import cv from '../data/cv.json';
---

<section class="max-w-3xl mx-auto px-6 py-16">
  <h1 class="text-4xl font-bold">{cv.personal.name}</h1>
  <p class="text-xl text-gray-600 mt-2">{cv.personal.title}</p>
  <p class="text-gray-500 mt-1">{cv.personal.tagline}</p>
  <p class="text-sm text-gray-400 mt-2">{cv.personal.location}</p>
</section>
