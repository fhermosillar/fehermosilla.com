---
import cv from '../data/cv.json';
---

<section class="max-w-3xl mx-auto px-6 py-12 border-t border-gray-100">
  <h2 class="text-2xl font-semibold mb-4">Contact</h2>
  <div class="flex gap-4 text-sm text-gray-600">
    <a href={cv.personal.links.linkedin} target="_blank" class="hover:text-gray-900">LinkedIn</a>
    <a href={cv.personal.links.github} target="_blank" class="hover:text-gray-900">GitHub</a>
  </div>
</section>
